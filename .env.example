PORT=3000
JWT_SECRET=change_this_to_a_long_random_string
APP_URL=http://localhost:3000

# ---- Database (REQUIRED) ----
# Free options:
#   1. Supabase  → https://supabase.com  (Project Settings → Database → Connection string → URI)
#   2. Neon      → https://neon.tech
#   3. Render    → create a free Postgres instance and copy the External Database URL
#
# Example (Supabase):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---- Email settings (for verification + password reset emails) ----
# Leave blank during development - a free temporary test inbox (Ethereal)
# will be used automatically, with a preview link printed to your terminal.
#
# To send REAL emails (Gmail):
# 1. Turn on 2-Step Verification: myaccount.google.com/security
# 2. Create an App Password: myaccount.google.com/apppasswords
# 3. Put the Gmail address in EMAIL_USER and the 16-character app password in EMAIL_PASS
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Lost & Found Portal <no-reply@lostfound.app>"
